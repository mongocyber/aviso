{
  "name": "aviso",
  "displayName": "Aviso",
  "version": "0.1.0",
  "description": "智能浏览器助手，感知操作对象，就地调用 AI，浮窗展示结果。无项目方服务器，无遥测。",
  "author": "Aviso",
  "scripts": {
    "dev": "plasmo dev",
    "dev:plasmo": "plasmo dev",
    "dev:wxt": "wxt --mv3",
    "build": "plasmo build",
    "build:plasmo": "plasmo build",
    "build:wxt": "wxt build --mv3",
    "check:manifests": "node scripts/check-extension-manifests.mjs",
    "package": "plasmo package",
    "package:plasmo": "plasmo package",
    "zip:wxt": "wxt zip --mv3",
    "postinstall": "wxt prepare",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "alias": {
    "../../src/popup.tsx": "./src/popup.tsx"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@mozilla/readability": "^0.6.0",
    "crypto-js": "^4.2.0",
    "openai": "^4.67.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/crypto-js": "^4.2.2",
    "@types/mozilla__readability": "^0.4.2",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "wxt": "^0.20.26"
  },
  "manifest": {
    "name": "Aviso",
    "default_locale": "zh_CN",
    "description": "__MSG_app_description__",
    "host_permissions": [
      "https://api.openai.com/*",
      "https://api.anthropic.com/*",
      "https://ark.cn-beijing.volces.com/*",
      "https://api.deepseek.com/*",
      "https://api.moonshot.cn/*",
      "https://openrouter.ai/*",
      "https://generativelanguage.googleapis.com/*",
      "https://api.hunyuan.cloud.tencent.com/*",
      "https://aviso-backend-production.vercel.app/*"
    ],
    "permissions": [
      "contextMenus",
      "activeTab",
      "storage",
      "history",
      "bookmarks",
      "identity",
      "clipboardWrite"
    ],
    "commands": {
      "open-command-palette": {
        "suggested_key": {
          "default": "Ctrl+Shift+Space",
          "mac": "Command+Shift+Space"
        },
        "description": "__MSG_open_command_palette_description__"
      }
    }
  }
}
