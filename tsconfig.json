{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "node_modules",
    ".wxt",
    ".output",
    "tests",
    "src/entrypoints",
    "src/wxt",
    "wxt.config.ts",
    "website"
  ],
  "include": [
    ".plasmo/index.d.ts",
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "compilerOptions": {
    "paths": {
      "~*": [
        "./src/*"
      ]
    },
    "baseUrl": "."
  }
}
