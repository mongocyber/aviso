{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviso.local/supply-chain-baseline.schema.json",
  "title": "Aviso local supply-chain baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "updated",
    "policy",
    "files",
    "directDependencies",
    "unresolvedHighCritical"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freshRegistryAudit", "runtimeBuildSeparation"],
      "properties": {
        "freshRegistryAudit": {
          "const": "pending-external"
        },
        "runtimeBuildSeparation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plasmoMustBeDevDependency"],
          "properties": {
            "plasmoMustBeDevDependency": {
              "const": true
            }
          }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package.json", "package-lock.json"],
      "properties": {
        "package.json": {
          "$ref": "#/$defs/trackedFile"
        },
        "package-lock.json": {
          "$ref": "#/$defs/trackedFile"
        }
      }
    },
    "directDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "dev"],
      "properties": {
        "runtime": {
          "$ref": "#/$defs/directDependencyList"
        },
        "dev": {
          "$ref": "#/$defs/directDependencyList"
        }
      }
    },
    "unresolvedHighCritical": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolvedHighCriticalRecord"
      }
    }
  },
  "$defs": {
    "trackedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "directDependencyList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "declaredVersion", "resolvedVersion"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "declaredVersion": {
            "type": "string",
            "minLength": 1
          },
          "resolvedVersion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unresolvedHighCriticalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "packageName",
        "owner",
        "impact",
        "expiresOn",
        "source",
        "advisory"
      ],
      "properties": {
        "severity": {
          "enum": ["high", "critical"]
        },
        "packageName": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "expiresOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "advisory": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
