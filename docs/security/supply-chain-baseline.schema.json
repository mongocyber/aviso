{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviso.local/supply-chain-baseline.schema.json",
  "title": "Aviso local supply-chain baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "updated",
    "policy",
    "files",
    "directDependencies",
    "unresolvedHighCritical",
    "closedHighCritical"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freshRegistryAudit", "runtimeBuildSeparation"],
      "properties": {
        "freshRegistryAudit": {
          "oneOf": [
            {
              "const": "pending-external"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": {
                "status": {
                  "const": "pending-external"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "auditDate", "evidence"],
              "properties": {
                "status": {
                  "enum": ["verified", "completed"]
                },
                "auditDate": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "evidence": {
                  "$ref": "#/$defs/auditEvidenceReferenceList"
                }
              }
            }
          ]
        },
        "runtimeBuildSeparation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plasmoMustBeDevDependency"],
          "properties": {
            "plasmoMustBeDevDependency": {
              "const": true
            }
          }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package.json", "package-lock.json"],
      "properties": {
        "package.json": {
          "$ref": "#/$defs/trackedFile"
        },
        "package-lock.json": {
          "$ref": "#/$defs/trackedFile"
        }
      }
    },
    "directDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "dev"],
      "properties": {
        "runtime": {
          "$ref": "#/$defs/directDependencyList"
        },
        "dev": {
          "$ref": "#/$defs/directDependencyList"
        }
      }
    },
    "unresolvedHighCritical": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolvedHighCriticalRecord"
      }
    },
    "closedHighCritical": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/closedHighCriticalRecord"
      }
    }
  },
  "$defs": {
    "trackedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "directDependencyList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "declaredVersion", "resolvedVersion"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "declaredVersion": {
            "type": "string",
            "minLength": 1
          },
          "resolvedVersion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unresolvedHighCriticalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "riskId",
        "severity",
        "packageName",
        "affectedPackage",
        "owner",
        "impact",
        "reviewDeadline",
        "source",
        "advisory"
      ],
      "properties": {
        "riskId": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["high", "critical"]
        },
        "packageName": {
          "type": "string",
          "minLength": 1
        },
        "affectedPackage": {
          "$ref": "#/$defs/affectedPackage"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "reviewDeadline": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "advisory": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "closedHighCriticalRecord": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["riskId", "closedOn", "closureType", "evidence"],
          "properties": {
            "riskId": {
              "type": "string",
              "minLength": 1
            },
            "closedOn": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "closureType": {
              "const": "dependency_changed"
            },
            "evidence": {
              "$ref": "#/$defs/nonEmptyStringList"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["riskId", "closedOn", "closureType", "evidence"],
          "properties": {
            "riskId": {
              "type": "string",
              "minLength": 1
            },
            "closedOn": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "closureType": {
              "const": "fresh_registry_audit"
            },
            "evidence": {
              "$ref": "#/$defs/freshRegistryAuditClosureEvidenceReferenceList"
            }
          }
        }
      ]
    },
    "auditEvidenceReferenceList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/auditEvidenceReference"
      }
    },
    "auditEvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "freshRegistryAuditClosureEvidenceReferenceList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/freshRegistryAuditClosureEvidenceReference"
      }
    },
    "freshRegistryAuditClosureEvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "riskId"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "riskId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "affectedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "resolvedVersion"],
      "properties": {
        "packageName": {
          "type": "string",
          "minLength": 1
        },
        "resolvedVersion": {
          "type": "string",
          "minLength": 1
        },
        "resolved": {
          "type": "string",
          "minLength": 1
        },
        "integrity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
